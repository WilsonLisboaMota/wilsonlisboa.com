---
// Leadership, on its own colour: seven arrowheads that fall in behind one, then what colleagues say, one at a time.
import { quotes } from '../data/site';

// The drawing: seven arrowheads start scattered, each pointing its own way, and turn to fly together behind the
// first one. Where they end is the formation in the hero. No tails: only heads, and one direction.
let seed = 19;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const end: [number, number][] = [[262, 100]];
for (let k = 1; k <= 3; k++) { end.push([262 - 58 * k, 100 - 28 * k]); end.push([262 - 58 * k, 100 + 28 * k]); }
const arrows = end.map(([x, y], i) => ({
  x, y,
  x0: Math.round(30 + rnd() * 250), y0: Math.round(24 + rnd() * 152), r0: Math.round(rnd() * 300 - 150),
  dl: (i ? 0.25 + rnd() * 0.7 : 0).toFixed(2),
  lead: i === 0,
}));
---
<section class="sx blue" id="leadership" data-sec aria-labelledby="ld-t">
  <div class="w">
    <div class="hd">
      <p class="meta kick">Leadership</p>
      <h2 id="ld-t">Analyst by trade. <em>Manager by choice.</em></h2>
      <svg class="aro" viewBox="0 0 320 200" aria-hidden="true">
        <g class="fly">
          {arrows.map(a => (
            <g class:list={['arw', { lead: a.lead }]} style={`--x:${a.x}px;--y:${a.y}px;--x0:${a.x0}px;--y0:${a.y0}px;--r0:${a.r0}deg;--dl:${a.dl}s`}>
              <path d={a.lead ? 'M-13 -11 L11 0 L-13 11 L-6 0 Z' : 'M-10 -8.500 L8 0 L-10 8.500 L-5 0 Z'} />
            </g>
          ))}
        </g>
      </svg>
      <p class="ld">From BI analyst in 2019 to leading a team of six BI developers today.</p>
    </div>

    <div class="qr" data-rot>
      <div class="q-stage">
        {quotes.map((q, i) => (
          <figure class:list={['q', { on: i === 0 }]} data-i={i}>
            <blockquote><p>“{q.text}”</p></blockquote>
            <figcaption class="who"><b>{q.name}</b>{q.role}{q.href && <> · <a class="lk" href={q.href} rel="noopener">{q.a}</a></>}</figcaption>
          </figure>
        ))}
      </div>
      <div class="q-tabs" role="tablist" aria-label="Who says it">
        {quotes.map((q, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-i={i}><i></i>{q.name}</button>)}
      </div>
    </div>
  </div>
</section>
