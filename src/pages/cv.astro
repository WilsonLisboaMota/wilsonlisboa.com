@keyframes present{0%,100%{text-shadow:none}50%{text-shadow:0 0 .6em rgba(47,84,150,.45)}}
.holo-pending .sheet{opacity:0}
/* ---------- print: the sheet alone, on one A4 page, in its final state ---------- */
@page{size:A4;margin:0}
@media print{
  html,body{background:#fff;height:297mm;overflow:hidden}
  .top,canvas,.e-tip,.e-ctl,.hit,.hit-name,.hit-photo{display:none!important}
  .stage{padding:0}
  .sheet{width:210mm;max-width:none;margin:0;box-shadow:none;opacity:1!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
  *,*::before,*::after{animation:none!important;transition:none!important}
