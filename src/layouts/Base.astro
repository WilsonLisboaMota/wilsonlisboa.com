---
import '../styles/base.css';

interface Props {
  title?: string;
  description?: string;
  /** Keeps search engines out of one page (the 404). The site launched on 13 November 2026. */
  noindex?: boolean;
  /** Lets a page family raise its own body styles above the shared ones without relying on stylesheet order. */
  bodyClass?: string;
}

const {
  title = 'Beyond the Dashboards',
  description = 'Wilson Mota. Business Intelligence, AI, leadership and the things I build beyond the dashboard.',
  noindex = false,
  bodyClass,
} = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex">}
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}>
<!-- What a shared link shows (LinkedIn, WhatsApp, Teams…): the title, the line, and the hero's front. -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="Wilson Mota">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)}>
<meta property="og:image" content="https://wilsonlisboa.com/og.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Beyond the dashboards: a line chart on a surface of fine blue lines.">
<meta name="twitter:card" content="summary_large_image">
<link rel="sitemap" href="/sitemap.xml">
<meta name="theme-color" content="#021C2A">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<!-- Visits (Umami Cloud, no cookies). Counted only on the real domain, never on localhost or pages.dev. -->
<script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="4d606881-f7a7-4525-9714-06518b6ff7de" data-domains="wilsonlisboa.com,www.wilsonlisboa.com"></script>
<!-- Set before the first paint, so what only makes sense with scripts on (closed panels, their buttons) never flashes. -->
<script is:inline>document.documentElement.classList.add('js')</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mona+Sans:wdth,wght@75..125,200..900&family=Martian+Mono:wdth,wght@75..112.5,300..600&display=swap">
</head>
<body class={bodyClass}>
<slot />
</body>
</html>
