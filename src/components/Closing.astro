---
// The end of the page: four ways to reach Wilson, as four things to press, and the last line.
import { person } from '../data/site';
import Icon from './Icon.astro';
import Title from './Title.astro';
---
<section class="sx ct" id="contact" data-sec data-glow aria-labelledby="ct-t">
  <div class="glow" aria-hidden="true"><svg><rect width="100%" height="100%" fill="url(#wl-dark)" /></svg></div>
  <div class="w">
    <div class="ct-h">
      <div class="ent"><svg class="sig-c" viewBox="0 0 160 100" aria-hidden="true"><circle class="rg" cx="50" cy="50" r="12"/><circle class="rg" cx="50" cy="50" r="12"/><circle class="rg" cx="50" cy="50" r="12"/><path class="ln" d="M62 50h92"/><circle class="dt" cx="50" cy="50" r="5"/></svg><p class="ent-n">Contact</p></div>
      <Title id="ct-t" a="Say hello." />
    </div>
    <div class="ct-g" data-seq>
      <a class="ct-i" href={`mailto:${person.email}`} data-play><Icon name="mail" /><span>{person.email}</span><svg class="go" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 16 17 7M9 7h8v8"/></svg></a>
      <a class="ct-i" href={person.linkedin} rel="noopener" data-play><Icon name="in" /><span>LinkedIn</span><svg class="go" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 16 17 7M9 7h8v8"/></svg></a>
      <a class="ct-i" href={person.github} rel="noopener" data-play><Icon name="git" /><span>GitHub</span><svg class="go" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 16 17 7M9 7h8v8"/></svg></a>
      <a class="ct-i" href={person.cv} data-play><Icon name="doc" /><span>The CV</span><svg class="go" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 16 17 7M9 7h8v8"/></svg></a>
    </div>
  </div>
</section>

<footer class="ft">
  <div class="w">
    <p>© {new Date().getFullYear()} Wilson Mota</p>
    <p><a href="#top">Back to the surface ↑</a></p>
  </div>
</footer>
