---
// The hero: a living data membrane the visitor scrolls through (WebGL, see src/scripts/membrane.js).
import '../styles/hero.css';
---
<section class="hero" id="top" aria-labelledby="title">
  <div class="stage">
    <canvas id="gl" aria-hidden="true"></canvas>
    <canvas id="fx" aria-hidden="true"></canvas>
    <p class="sr-only">Visual: a translucent surface made of fine lines, with a line chart running across it. Three structures behind it push it into shape. Scrolling carries you through the surface to the other side, where the three become visible: Business Intelligence, Artificial Intelligence and Leadership. The data is illustrative.</p>

    <header class="top">
      <a class="name" href="#top"><b>Wilson Mota</b><span>Business Intelligence Manager</span></a>
      <nav aria-label="Primary">
        <a href="#ai">Work</a>
        <a href="#trajectory">Trajectory</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <div class="copy" id="copy">
      <h1 id="title"><span>Beyond the</span> <span>dashboards<span class="dot">.</span></span></h1>
      <div class="under">
        <p class="lede">What if the charts I build are only a fraction of what I deliver?</p>
        <a class="cta" href="#work"><span>Step behind the dashboard</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>
    </div>

    <div class="behind" id="behind">
      <p class="kicker mono">Behind the dashboard</p>
      <p class="big">I design data platforms, build with AI and lead a BI team.</p>
    </div>

    <div class="readout">
      <p class="r-hint mono" id="hint" aria-hidden="true" hidden>Choose a word to explore</p>
    </div>

    <!-- The words on the far side are the buttons (see membrane.js). These links stay for the keyboard and for screen
         readers, out of sight; focusing one lights its force up, as pointing does. -->
    <nav class="forces sr" id="forces" aria-label="What lies behind the dashboard">
      <a class="force" href="#bi" data-k="0"><b>Business Intelligence</b></a>
      <a class="force" href="#ai" data-k="1"><b>Artificial Intelligence</b></a>
      <a class="force" href="#leadership" data-k="2"><b>Leadership</b></a>
    </nav>

    <!-- What comes out of the AI's point, typed (see membrane.js). Decorative, so hidden from screen readers. -->
    <!-- Shown once the far side lets the scroll go on (see the gate in membrane.js). -->
    <span class="cue" id="cue" aria-hidden="true"><i></i><i></i></span>
    <p class="answer" id="answer" aria-hidden="true"><span class="t"><span class="x"></span><span class="c"></span></span></p>
  </div>
</section>

<script>
  import '../scripts/membrane.js';
</script>
