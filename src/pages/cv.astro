<style is:inline>
@property --p{syntax:'<number>';inherits:false;initial-value:0}
:root{--deep:#021C2A;--mist:#E4ECE9;--signal:#E0952F;--gutter:clamp(8px,3.4vw,48px);--ease:cubic-bezier(.2,.7,.2,1);color-scheme:dark}
