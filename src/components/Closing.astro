---
// The end of the page: three ways to reach Wilson, as three things to press, and the last line.
import { person } from '../data/site';
import Icon from './Icon.astro';
---
<section class="sx ct" id="contact" data-sec data-glow aria-labelledby="ct-t">
  <div class="glow" aria-hidden="true"><svg><rect width="100%" height="100%" fill="url(#wl-dark)" /></svg></div>
  <div class="w">
    <h2 id="ct-t">Say hello.</h2>
    <div class="ct-g" data-seq>
      <a class="ct-i" href={`mailto:${person.email}`} data-play><Icon name="mail" /><span>{person.email}</span></a>
      <a class="ct-i" href={person.linkedin} rel="noopener" data-play><Icon name="in" /><span>LinkedIn</span></a>
      <a class="ct-i" href={person.cv} data-play><Icon name="doc" /><span>The CV</span></a>
    </div>
  </div>
</section>

<footer class="ft">
  <div class="w">
    <p>© {new Date().getFullYear()} Wilson Mota</p>
    <p><a href="/built-with-ai/">How this site was built</a><a href="#top">Back to the surface ↑</a></p>
  </div>
</footer>
