@keyframes surge{0%{text-shadow:0 0 0 rgba(47,84,150,0)}14%{color:#2F5496;text-shadow:0 0 1em rgba(47,84,150,.85),0 0 .2em rgba(47,84,150,.9)}100%{text-shadow:0 0 .55em rgba(47,84,150,.3)}}

/* ---------- motion ---------- */
@media (prefers-reduced-motion:no-preference){
  .js .tk path{stroke-dasharray:1.05;stroke-dashoffset:1.05;transition:stroke-dashoffset .45s var(--ease),stroke .25s}
  .js .ck.on .tk path{stroke-dashoffset:0}
  .js .ck.glint .tk path{stroke:#6E9BE6;filter:drop-shadow(0 0 2px rgba(80,140,230,.8))}
  .js .dot::before{--p:0;transition:--p var(--fd,.2s) linear var(--fdl,0s)}
  .js .dot.on::before{--p:var(--f)}
  .js .dot.snap::before{transition:none}
  .js .dot.on::after{animation:flash .8s ease-out calc(var(--fdl,0s) + var(--fd,.2s))}
  .rule::before{animation:current 5.5s linear infinite}
  .js .dot.live::after{animation:halo var(--hd,3.4s) ease-in-out var(--hdl,0s) infinite alternate}
  .js .dot.live.flick::after{animation:flash .7s ease-out}
  .js .bar.live .fill{animation:breathe var(--bd,3.8s) ease-in-out infinite alternate}
  .js .bar.run .flow{animation:flow 1.6s cubic-bezier(.4,.1,.3,1)}
  .live-w{animation:present 3.6s ease-in-out infinite}
}
@keyframes flash{0%{opacity:.95}100%{opacity:0}}
@keyframes halo{from{opacity:0}to{opacity:.32}}
@keyframes breathe{from{box-shadow:0 0 0 rgba(200,230,255,0)}to{box-shadow:0 0 calc(5 * var(--pt)) rgba(200,230,255,.6)}}
@keyframes flow{to{transform:translateX(270%)}}
