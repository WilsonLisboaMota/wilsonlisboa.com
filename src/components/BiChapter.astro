---
// Business Intelligence: what Wilson is today, first. The path that led there opens on request, as steps that climb;
// the button that opens it hangs from the middle of the Today card's bottom edge and carries the steps in small.
// Then the proof, as cards. The section starts where the dark ends, at a seam of the hero's own fine lines.
import { roles, todayTiles, proofs } from '../data/site';
import Card from './Card.astro';
import Sheet from './Sheet.astro';
import Icon from './Icon.astro';
import Seam from './Seam.astro';

// The BI drawing from the hero: tables below, lineage rising to the points of the chart above.
const pts = [[64, 46], [150, 30], [236, 40]];
const tables = [[20, 138, 78, 44], [121, 150, 78, 44], [222, 138, 78, 44]];
let sig = `<path d="M10 58C40 30 52 60 ${pts[0][0]} ${pts[0][1]}S118 20 ${pts[1][0]} ${pts[1][1]} 208 54 ${pts[2][0]} ${pts[2][1]} 296 18 310 26" style="--dl:.9s"/>`;
tables.forEach(([x, y, w, h], i) => {
  sig += `<path d="M${x} ${y}h${w}v${h}h${-w}zM${x} ${y + 11}h${w}M${x} ${y + 22}h${w}M${x} ${y + 33}h${w}M${x + w / 3} ${y + 11}v${h - 11}M${x + (2 * w) / 3} ${y + 11}v${h - 11}" style="--dl:${(i * 0.12).toFixed(2)}s"/>`;
  const [px, py] = pts[i], cx = x + w / 2;
  sig += `<path d="M${cx} ${y}C${cx} ${y - 46} ${px} ${py + 58} ${px} ${py}" style="--dl:${(0.45 + i * 0.12).toFixed(2)}s"/>`;
  // Once drawn, a light rises from each table to its point on the chart, and the point answers.
  sig += `<path class="pl" pathLength="100" d="M${cx} ${y}C${cx} ${y - 46} ${px} ${py + 58} ${px} ${py}" style="--pd:${(i * 0.8).toFixed(1)}s"/>`;
});
sig += pts.map(([x, y], i) => `<circle class="ring" cx="${x}" cy="${y}" r="3.5" style="--pd:${(i * 0.8).toFixed(1)}s"/><circle cx="${x}" cy="${y}" r="3.5"/>`).join('');

const now = roles[roles.length - 1];
const first = roles[0].id;
const chev = '<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4.2 6 8l4-3.8"/></svg>';
---
<section class="sx paper" id="bi" data-sec data-glow aria-labelledby="bi-t">
  <div class="glow" aria-hidden="true"><svg><rect width="100%" height="100%" fill="url(#wl-paper)" /></svg></div>
  <Seam fill="#021C2A" side="above" up="#8FD0FF" down="#00486F" />
  <div class="w">
    <div class="hd">
      <p class="meta kick">Business Intelligence</p>
      <h2 id="bi-t">Above: the chart. <em>Below: the platform.</em></h2>
      <svg class="sig" viewBox="0 0 320 200" aria-hidden="true" set:html={sig}></svg>
      <p class="ld">Seven years in regulated environments, from analyst to manager.</p>
    </div>

    <div class="today" data-tilt="soft" data-play>
      <div class="today-h">
        <p class="st live">Today</p>
        <h3>{now.title}</h3>
        <p class="org">{now.org} · since {now.from}</p>
      </div>
      <ul class="tiles" data-seq>
        {todayTiles.map(t => <li><Icon name={t.icon} /><span>{t.t}</span></li>)}
      </ul>
    </div>

    <div class="path-w" id="trajectory">
      <button class="go-b go-path" type="button" aria-expanded="false" aria-controls="bh-path">
        <span class="pm" aria-hidden="true">{roles.map((r, k) => <i style={`--h:${r.level};--k:${k}`}></i>)}</span>
        <span class="x">See my full career path</span><span class="y">Hide my career path</span>
        <Fragment set:html={chev} />
      </button>
      <div class="bh" id="bh-path">
        <div class="bh-in">
          <div class="path" data-pick={first}>
            <div class="steps" role="tablist" aria-label="The path, step by step">
              {roles.map(r => (
                <button class:list={['step', { hollow: r.kind !== 'main', on: r.id === first }]} type="button" role="tab" aria-selected={r.id === first ? 'true' : 'false'} data-role={r.id} style={`--h:${r.level}`}>
                  <span class="bar"></span><span class="yr">{r.from}</span><span class="nm">{r.short}</span>
                </button>
              ))}
            </div>
            <div class="role">
              {roles.map(r => (
                <div class:list={['role-p', { on: r.id === first }]} data-for={r.id}>
                  <p class="meta">{r.when}</p>
                  <h4>{r.title} · {r.org}</h4>
                  <ul>{r.bullets.map(b => <li>{b}</li>)}</ul>
                  {r.note && <p class="nt">{r.note}</p>}
                  {r.tools.length > 0 && <p class="chips">{r.tools.map(t => <span>{t}</span>)}</p>}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <h3 class="sub">Projects and certification</h3>
    <div class="cards three" data-seq>
      {proofs.map(p => <Card w={p} />)}
    </div>
  </div>
  {proofs.filter(p => !p.external).map(p => <Sheet w={p} />)}
</section>
