:where(.pg) :is(p,h1,h2,h3){margin:0;font-weight:400}
.box{position:absolute;left:calc(var(--x) * var(--pt));top:calc(var(--y) * var(--pt));width:calc(var(--w) * var(--pt));height:calc(var(--h) * var(--pt))}
/* Text sits on its PDF baseline. */
.t{position:absolute;left:calc(var(--x) * var(--pt));top:calc((var(--b) - var(--s) * .86) * var(--pt));font-size:calc(var(--s) * var(--pt));line-height:1;white-space:nowrap}

/* Sidebar */
.side-panel{--x:8.6;--y:8.05;--w:221.04;--h:827.65;background:rgba(255,255,255,.25);border-radius:calc(2.9 * var(--pt))}
.paper-panel{--x:233.2;--y:7.5;--w:352.95;--h:828.25;background:#fff;border-radius:calc(2.9 * var(--pt))}
