/* ---------- the sheet: the PDF page, measured in PDF points so it scales like the PDF ---------- */
.sheet{position:relative;width:min(960px,100%);margin:0 auto;aspect-ratio:595.32/841.92;container-type:inline-size;overflow:hidden;
  background:linear-gradient(110deg,#1F3763 0%,#233E6F 38%,#2A4B86 60%,#3864B2 89%,#4472C4 103%);
