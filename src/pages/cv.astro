<script is:inline src="/cv/energy.js"></script>
<script is:inline>
(() => {
  const E = window.Energy;
  const $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const rnd = E.rnd;
  document.documentElement.classList.add('js');

  const sheet = document.querySelector('.sheet');
  // The text is split into words once, so the energy can act on the words themselves.
  const words = E.wordify(sheet);
  const ticks = $$('.ck'), rows = $$('.srow'), dots = $$('.dot'), bars = $$('.bar'), rules = $$('.rule'), contacts = $$('.ct-li');
  const restart = (el, cls, ms) => { el.classList.remove(cls); void el.offsetWidth; el.classList.add(cls); if (ms) setTimeout(() => el.classList.remove(cls), ms); };
  const tickSpark = (b, o = {}) => { const s = b.querySelector('.tk').getBoundingClientRect(), r = b.getBoundingClientRect(); E.spark(b, s.right - r.left, s.top - r.top - 1, { size: 7, life: 620, ...o }); };

  /* ---- the indicators' small reactions, reused by the entry, the ambient life and the pulse ---- */
  function flick(d) {
    if (!d.classList.contains('live')) return;
    restart(d, 'flick', 750);
    E.spark(d, d.offsetWidth / 2 + rnd(-7, 7), rnd(-6, -2), { size: 6.5, life: 600, gain: 0.8 });
  }
  function glint(b) {
    if (!b.classList.contains('on') || b.classList.contains('e-on') || b.classList.contains('e-link')) return;
    restart(b, 'glint', 700);
    tickSpark(b, { gain: 0.8 });
  }
  // A soft current runs along a language bar, and its head gives off a few glyphs.
  function flow(bar) {
    restart(bar, 'run');
    setTimeout(() => {
      const p = +bar.style.getPropertyValue('--bp') || +getComputedStyle(bar).getPropertyValue('--v');
      for (let k = 0; k < 2; k++) E.spark(bar, p * bar.offsetWidth + rnd(-2, 4), rnd(-6, bar.offsetHeight + 6), { size: 7, life: 600 });
    }, 1250);
  }
  function run(rule) { restart(rule, 'run'); }
  function zap(li, burst = true) {
    li.classList.add('zap');
    restart(li, 'sweep', 900);
    if (burst) E.burst(li.querySelector('.pill-c'), { reach: 15, gain: 0.85 });
  }

  // Which roles used which tool: Wilson's own table (18 Oct 2026), never inferred from the CV text.
  const ROLE_TOOLS = {
    corient: ['ssms', 'mage', 'powerbi', 'tableau', 'databricks', 'copilot', 'claude'],
    sf: ['ssms', 'ssis', 'alteryx', 'mage', 'powerbi', 'excel', 'dremio', 'bc', 'copilot'],
    fl: ['ssms', 'ssis', 'powerbi', 'excel'],
    sl: ['ssms', 'ssis', 'powerbi', 'excel'],
    wv: ['excel'],
  };
  const titlesUsing = k => $$('.ti[data-role]').filter(ti => (ROLE_TOOLS[ti.dataset.role] || []).includes(k));

  /* ---- skills: a skill charges every line where it was applied, and the title of every role that used it ---- */
  E.bind({
    targets: k => [...$$(`.paper [data-uses~="${k}"]`), ...titlesUsing(k)],
    onSkill: (btn, on) => { if (on) E.burst(btn, { reach: 16, gain: 0.7 }); }
  });

  /* ---- roles: pointing at a title charges its lines and lights the tools that role used ---- */
  let roleOn = null;
  function setRole(ti, on) {
    const lines = $$(`.paper [data-r="${ti.dataset.role}"]`);
    const used = new Set(ROLE_TOOLS[ti.dataset.role] || []);
    ti.classList.toggle('e-on', on);
    document.documentElement.classList.toggle('e-dim', on);
    clearTimeout(ti._t);
    if (on) {
      E.burst(ti, { reach: 18, gain: 0.8 });
      // The charge runs down through the role, line after line.
      lines.forEach((l, i) => setTimeout(() => { if (ti.classList.contains('e-on')) E.charge(l, true, { reach: 14 }); }, E.reduced ? 0 : 120 + i * 110));
      ticks.filter(b => used.has(b.dataset.skill)).forEach((b, i) => setTimeout(() => {
        if (!ti.classList.contains('e-on')) return;
        b.classList.add('e-link');
        tickSpark(b);
      }, E.reduced ? 0 : 200 + i * 90));
    } else {
      lines.forEach(l => E.charge(l, false));
      ticks.forEach(b => b.classList.remove('e-link'));
    }
  }
  const roleActivate = ti => { if (roleOn === ti) return; if (roleOn) setRole(roleOn, false); roleOn = ti; setRole(ti, true); };
  const roleRelease = ti => { if (roleOn !== ti) return; setRole(ti, false); roleOn = null; };
  $$('.ti[data-role]').forEach(ti => {
    if (E.fine) {
      ti.addEventListener('pointerenter', () => roleActivate(ti));
      ti.addEventListener('pointerleave', () => roleRelease(ti));
    } else {
      ti.addEventListener('click', () => (roleOn === ti ? roleRelease(ti) : roleActivate(ti)));
    }
    ti.addEventListener('focus', () => { if (ti.matches(':focus-visible')) roleActivate(ti); });
    ti.addEventListener('blur', () => roleRelease(ti));
  });

  /* ---- contacts and company names answer the pointer ---- */
  contacts.forEach(li => {
    li.addEventListener('pointerenter', () => zap(li));
    li.addEventListener('pointerleave', () => li.classList.remove('zap'));
    const a = li.querySelector('a');
    if (a) { a.addEventListener('focus', () => zap(li)); a.addEventListener('blur', () => li.classList.remove('zap')); }
  });
  $$('.co a:not(.mag)').forEach(a => a.addEventListener('pointerenter', () => { restart(a, 'e-surge'); E.burst(a, { reach: 14, gain: 0.8 }); }));

  /* ---- the hologram: the photo projects the CV; the name and the photo can reinforce it ---- */
  const photo = document.querySelector('.photo');
  function geometry() {
    const s = sheet.getBoundingClientRect(), f = photo.getBoundingClientRect();
    const paperX = document.querySelector('.paper-panel').getBoundingClientRect().left - s.left;
    const side = E.palette(document.querySelector('.side')), paper = E.palette(document.querySelector('.paper'));
    return { s, ox: f.left + f.width / 2 - s.left, oy: f.top + f.height / 2 - s.top, colorAt: x => (x > paperX ? paper : side), cell: Math.max(7, Math.min(12, s.width / 85)) };
  }
  // The boxes whose edges light up as the wave crosses them.
  const edges = () => [sheet, ...$$('.side-panel, .paper-panel, .sumbox, .pill-c, .pill, .photo')];
  function projectSheet() {
    const g = geometry();
    return E.project(sheet, g.ox, g.oy, { colorAt: g.colorAt, cell: g.cell, dur: 1400, edges: edges() });
  }
  let lastPulse = 0;
  function sheetPulse() {
    const now = performance.now();
    if (now - lastPulse < 1600) return;
    lastPulse = now;
    const { s, ox, oy, colorAt, cell } = geometry();
    const speed = E.pulse(sheet, ox, oy, { colorAt, cell, density: 0.34, gain: 1.3, edges: edges() });
    if (!speed) return;
    const at = el => { const r = el.getBoundingClientRect(); return Math.hypot(r.left + r.width / 2 - s.left - ox, r.top + r.height / 2 - s.top - oy) / speed * 1000; };
    // As the front passes, the CV's own indicators answer it...
    dots.forEach(d => setTimeout(() => flick(d), at(d)));
    ticks.forEach(b => setTimeout(() => glint(b), at(b)));
    bars.forEach(b => setTimeout(() => flow(b), at(b)));
    rules.forEach(r => setTimeout(() => run(r), at(r)));
    contacts.forEach(li => { const p = li.querySelector('.pill-c'); setTimeout(() => { zap(li, false); setTimeout(() => li.classList.remove('zap'), 500); }, at(p)); });
    // ...and some lines of text give off a little of it.
    $$('.paper .t, .side .t').forEach(el => {
      if (Math.random() > 0.55) return;
      setTimeout(() => E.spark(el, rnd(0, el.offsetWidth), rnd(-6, el.offsetHeight + 6), { size: 7, life: 700 }), at(el) + rnd(0, 120));
    });
  }
  // Only the photo sends the pulse across the sheet (Wilson, 18 Oct 2026); the name keeps its "about" tooltip.
  $$('.hit-photo').forEach(b => b.addEventListener('tipshow', sheetPulse));

  /* ---- the membrane: invisible; a touch where there is nothing to touch makes the energy dip ---- */
  E.membrane(sheet, { words, extras: [...dots, ...bars, ...$$('.tk'), ...rules, ...$$('.pill-c'), ...$$('.pill')] });
  // The name: the letters under the pointer turn into code while it rests on them.
  E.unsettle(document.querySelector('.hit-name'), [document.querySelector('h1.nm'), document.querySelector('.gv')]);

  // First visit: the photo projects the CV. The indicators charge once it is lit.
  const ready = document.documentElement.classList.contains('holo-pending') && E.firstVisit('cv-holo-a') ? projectSheet() : Promise.resolve();
  document.documentElement.classList.remove('holo-pending');

  /* ---- entry: the CV charges up as it comes into view ---- */
  function entryTicks() {
    ticks.forEach((b, i) => setTimeout(() => { b.classList.add('on'); tickSpark(b, { life: 600 }); }, E.reduced ? 0 : 120 + i * 70));
  }
  function live(d) {
    d.style.setProperty('--hd', rnd(2.6, 4.6).toFixed(2) + 's');
    d.style.setProperty('--hdl', (-rnd(0, 4)).toFixed(2) + 's');
    d.classList.add('live');
  }
  // Each row fills from left to right, dot after dot, like one continuous charge.
  function fillRow(row, start, step) {
    $$('.dot', row).forEach((d, k) => {
      d.classList.add('snap');
      d.classList.remove('on');
      void d.offsetWidth;
      d.classList.remove('snap');
      d.style.setProperty('--fd', step + 's');
      d.style.setProperty('--fdl', (start + k * step).toFixed(2) + 's');
      d.classList.add('on');
      if (!E.reduced) setTimeout(() => {
        E.spark(d, d.offsetWidth * rnd(0.6, 1.1), rnd(-6, -2), { size: 7, life: 600 });
        if (!d.classList.contains('live')) setTimeout(() => live(d), 800);
      }, (start + (k + 1) * step) * 1000);
      else live(d);
    });
  }
  function entryDots() { rows.forEach((row, r) => fillRow(row, 0.15 + r * 0.15, 0.2)); }
  function chargeBar(bar, delay) {
    const v = +getComputedStyle(bar).getPropertyValue('--v');
    setTimeout(() => {
      bar.classList.add('charging');
      let last = 0;
      E.tween(1350, t => {
        const e = 1 - Math.pow(1 - t, 3);
        // Energy comes in with small stutters, not as a smooth slide.
        const p = v * Math.min(1, e + 0.018 * Math.sin(t * 40) * (1 - t));
        bar.style.setProperty('--bp', p.toFixed(4));
        const now = performance.now();
        if (now - last > 70 && t < 1) { last = now; E.spark(bar, p * bar.offsetWidth, rnd(-7, bar.offsetHeight + 7), { size: 7, life: 520 }); }
      }, () => {
        bar.classList.remove('charging');
        bar.style.setProperty('--bd', rnd(3, 4.8).toFixed(2) + 's');
        bar.classList.add('live');
      });
    }, E.reduced ? 0 : delay);
  }
  function entryBars() { bars.forEach((b, i) => chargeBar(b, 200 + i * 170)); }

  function reset() {
    ticks.forEach(b => b.classList.remove('on'));
    dots.forEach(d => d.classList.remove('on', 'live', 'flick'));
    bars.forEach(b => { b.classList.remove('live', 'charging'); if (!E.reduced) b.style.setProperty('--bp', 0); });
  }
  reset();
  E.onEnter(ticks[0], () => ready.then(entryTicks), '-8%');
  E.onEnter(dots[0], () => ready.then(entryDots));
  E.onEnter(bars[0], () => ready.then(entryBars), '-4%');

  /* ---- ambient life: never static, always subtle ---- */
  bars.forEach(b => E.every(b, () => { if (b.classList.contains('live')) flow(b); }, 2800, 6800));
  E.every(dots[0], () => flick(dots[(Math.random() * dots.length) | 0]), 1500, 3800);
  E.every(ticks[0], () => glint(ticks[(Math.random() * ticks.length) | 0]), 2600, 6000);
  // The section rules: a permanent quiet current (CSS), a brighter pulse now and then, and glyphs rising from them.
  rules.forEach(r => {
    E.every(r, () => run(r), 4500, 9000);
    E.every(r, () => E.spark(r, rnd(0.05, 0.95) * r.offsetWidth, -2, { size: 6.5, life: rnd(700, 1100), gain: 0.75, rise: 7 }), 700, 1900);
  });

  /* ---- tooltips also wake their indicator ---- */
  rows.forEach(row => row.querySelector('.hit').addEventListener('tipshow', () => {
    fillRow(row, 0, 0.16);
    E.burst($$('.dot', row)[4], { cell: 7, reach: 16, gain: 0.8 });
  }));
  $$('.langs li').forEach(li => li.querySelector('.hit').addEventListener('tipshow', () => flow(li.querySelector('.bar'))));


})();
</script>
</body>
</html>
