/* Soft-skill dots: a ring, filled from left to right, so a row reads like one continuous charge. */
.dot{position:absolute;width:calc(11.7 * var(--pt));height:calc(11.7 * var(--pt));left:calc((var(--cx) - 5.85) * var(--pt));top:calc((var(--b) - 10.75) * var(--pt));
  border-radius:50%;box-shadow:inset 0 0 0 calc(.9 * var(--pt)) #fff,0 calc(.6 * var(--pt)) calc(1.4 * var(--pt)) rgba(0,0,0,.28);--f:1}
.dot::before{content:"";position:absolute;inset:calc(.9 * var(--pt));border-radius:50%;--p:var(--f);background:linear-gradient(90deg,#fff calc(var(--p) * 100%),transparent 0)}
.dot::after{content:"";position:absolute;inset:calc(-4 * var(--pt));border-radius:50%;background:radial-gradient(closest-side,rgba(220,238,255,.75),rgba(150,205,255,0));opacity:0;pointer-events:none}
.dot:nth-child(2){--cx:160.6}.dot:nth-child(3){--cx:179.9}.dot:nth-child(4){--cx:197.9}.dot:nth-child(5){--cx:217;--f:var(--last,1)}
.dot:nth-child(1){--cx:142.3}

/* Language bars */
.bar{position:absolute;left:calc(61 * var(--pt));width:calc(158 * var(--pt));top:calc((var(--b) - 6.9) * var(--pt));height:calc(7 * var(--pt));background:rgba(255,255,255,.32)}
.bar .fill{position:absolute;left:0;top:0;bottom:0;width:calc(var(--bp, var(--v)) * 100%);background:#fff;overflow:hidden}
.bar .flow{position:absolute;top:0;bottom:0;left:0;width:40%;background:linear-gradient(90deg,rgba(120,190,255,0),rgba(96,176,255,.85) 60%,rgba(120,190,255,0));transform:translateX(-110%)}
.bar .head{position:absolute;top:-80%;bottom:-80%;left:calc(var(--bp, var(--v)) * 100%);width:calc(9 * var(--pt));margin-left:calc(-4.5 * var(--pt));
  background:radial-gradient(closest-side,rgba(255,255,255,.95),rgba(170,215,255,0));opacity:0;transition:opacity .5s var(--ease)}
.bar.charging .head{opacity:1}

/* Row hit areas for the tooltips */
.hit{position:absolute;left:calc(14 * var(--pt));width:calc(212 * var(--pt));top:calc((var(--b) - 12) * var(--pt));height:calc(16.5 * var(--pt));
  padding:0;margin:0;border:0;background:none;cursor:help;-webkit-tap-highlight-color:transparent;border-radius:calc(2 * var(--pt));font-size:0;color:transparent}
.hit:hover,.hit.e-tipped{background:rgba(255,255,255,.08)}
/* Name and photo: who Wilson is beyond the CV, and a pulse through the whole sheet. */
.hit-name{position:absolute;left:calc(12 * var(--pt));top:calc(18 * var(--pt));width:calc(212 * var(--pt));height:calc(70 * var(--pt));padding:0;margin:0;border:0;background:none;
  cursor:help;font-size:0;color:transparent;border-radius:calc(3 * var(--pt));-webkit-tap-highlight-color:transparent;transition:background-color .3s}
/* No box behind the name on hover (Wilson, 18 Oct 2026): the code effect on the letters is enough. */
.hit-photo{position:absolute;z-index:2;left:calc(77.5 * var(--pt));top:calc(128.5 * var(--pt));width:calc(84 * var(--pt));height:calc(84 * var(--pt));padding:0;margin:0;border:0;
  border-radius:50%;background:none;cursor:help;font-size:0;color:transparent;-webkit-tap-highlight-color:transparent;transition:box-shadow .35s var(--ease)}
.hit-photo:hover,.hit-photo.e-tipped{box-shadow:0 0 0 calc(2.6 * var(--pt)) #fff,0 0 calc(10 * var(--pt)) calc(2 * var(--pt)) rgba(170,215,255,.75)}
/* Contact pills answer the pointer: a sheen runs across, the icon lights and code sparks around. */
.pill-c::after{content:"";position:absolute;inset:0;border-radius:inherit;background:linear-gradient(100deg,transparent 35%,rgba(255,255,255,.6) 50%,transparent 65%) no-repeat;
  background-size:250% 100%;background-position:130% 0;opacity:0}
.ct-li .pill-c{transition:background-color .35s var(--ease)}
.ct-li.zap .pill-c{background:rgba(255,255,255,.34)}
.ct-li .ico{transition:filter .35s var(--ease)}
.ct-li.zap .ico{filter:drop-shadow(0 0 calc(2.2 * var(--pt)) rgba(205,232,255,.95))}
.ct-li.sweep .pill-c::after{animation:sheen .85s cubic-bezier(.3,.1,.3,1)}
@keyframes sheen{0%{opacity:1;background-position:130% 0}100%{opacity:1;background-position:-30% 0}}

/* Main column */
.paper{color:#404040;--e-main:47,84,150;--e-hot:224,149,47;--e-blend:source-over;--e-gain:.95}
.pill{position:absolute;left:calc(234 * var(--pt));width:calc(110 * var(--pt));height:calc(18 * var(--pt));top:calc((var(--b) - 12.9) * var(--pt));
  border-radius:calc(9 * var(--pt));background:linear-gradient(90deg,#1F3B70 0%,#2A4B86 48%,#5577B4 80%,#8FAADC 100%);
  color:#fff;font-size:calc(11.04 * var(--pt));line-height:calc(18 * var(--pt));padding-left:calc(17.2 * var(--pt));letter-spacing:.01em}
/* Section rules carry a permanent, quiet current; now and then a brighter pulse, and a few glyphs rise from them. */
.rule{position:absolute;left:calc(344 * var(--pt));width:calc(194 * var(--pt));top:calc((var(--b) - 4.1) * var(--pt));height:max(1px,calc(.8 * var(--pt)));background:#1F4E79;overflow:hidden;
  box-shadow:0 0 calc(2.2 * var(--pt)) rgba(96,176,255,.4)}
.rule::before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(90deg,rgba(150,210,255,0) 0,rgba(150,210,255,0) 30%,rgba(165,218,255,.95) 42%,rgba(150,210,255,0) 54%,rgba(150,210,255,0) 100%);
  background-size:50% 100%;opacity:.5}
.rule::after{content:"";position:absolute;top:-1px;bottom:-1px;left:0;width:22%;background:linear-gradient(90deg,rgba(96,176,255,0),rgba(140,200,255,1),rgba(96,176,255,0));transform:translateX(-110%)}
.rule.run::after{animation:rule 2.2s cubic-bezier(.4,.1,.3,1)}
@keyframes rule{to{transform:translateX(480%)}}

.ck{position:absolute;left:calc(var(--x) * var(--pt));top:calc((var(--b) - 9.6) * var(--pt));display:flex;align-items:center;gap:calc(6.6 * var(--pt));
  padding:calc(1.4 * var(--pt)) calc(2 * var(--pt)) calc(1.4 * var(--pt)) 0;margin:0;border:0;background:none;cursor:default;
  font:inherit;font-size:calc(9 * var(--pt));line-height:1;color:#404040;white-space:nowrap;-webkit-tap-highlight-color:transparent}
.tk{width:calc(7.5 * var(--pt));height:calc(7.5 * var(--pt));overflow:visible;flex:none}
.tk path{fill:none;stroke:#2F5496;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;transition:stroke .25s}
.ck.e-on{color:#14305E;text-shadow:0 0 .6em rgba(47,84,150,.35)}
