a.mag{cursor:pointer}
a.mag:hover{color:#1F4E79}
/* Role titles: pointing at one charges its lines and lights the tools that role used. */
.ti[data-role]{cursor:default;transition:text-shadow .35s var(--ease)}
.ti.e-on{text-shadow:0 0 .5em rgba(47,84,150,.35)}
.ck.e-link{color:#14305E;text-shadow:0 0 .6em rgba(47,84,150,.35)}
