---
// The footer: the map once more, the way back to the surface, and the colophon.
const year = new Date().getFullYear();
---
<footer class="foot" id="footer">
  <div class="wrap">
    <div class="brand">
      <a class="name" href="/#top">Wilson Mota</a>
      <p class="tag">Beyond the dashboards<span class="dot">.</span></p>
      <p class="sub">Business Intelligence Manager · Fribourg, Switzerland</p>
    </div>
    <nav class="cols" aria-label="Footer">
      <div>
        <p class="meta">Chapters</p>
        <a href="/#now">Now</a>
        <a href="/#bi">Business Intelligence</a>
        <a href="/#ai">Artificial Intelligence</a>
        <a href="/#leadership">Leadership</a>
        <a href="/#entrepreneurship">Entrepreneurship</a>
        <a href="/#cv">CV</a>
      </div>
      <div>
        <p class="meta">Work</p>
        <a href="/work/ai-trading-bot/">AI Trading Bot</a>
        <a href="/work/ai-trading-bot/bitcoin-study/">Bitcoin study</a>
        <a href="/work/power-bi-mcp/">Power BI, read by an AI</a>
        <a href="/built-with-ai/">How this site was built</a>
      </div>
      <div>
        <p class="meta">Elsewhere</p>
        <a href="mailto:wilson.lisboa@wilsonlisboa.com">Email</a>
        <a href="https://www.linkedin.com/in/wilson-lisboa-mota/" rel="noopener">LinkedIn</a>
        <a href="/cv/">The CV</a>
        <a href="/cv/wilson-lisboa-mota-cv.pdf" download>CV as PDF</a>
      </div>
    </nav>
    <div class="colophon">
      <p>Built with Astro and three.js, with Claude. Hosted on GitHub Pages. No cookies, no tracking.</p>
      <p>The data in the hero is illustrative. Every figure in the chapters has its source on the page.</p>
      <p class="legal">© {year} Wilson Lisboa Mota · <a href="/#top">Back to the surface <span aria-hidden="true">↑</span></a></p>
    </div>
  </div>
</footer>

<style>
  .foot{position:relative;color:var(--mist);background:linear-gradient(180deg,rgba(2,28,42,0) 0%,rgba(0,16,26,.85) 100%);border-top:1px solid var(--mist-15)}
  .foot .wrap{max-width:1320px;margin:0 auto;padding:clamp(48px,8vh,80px) var(--gutter) calc(env(safe-area-inset-bottom,0px) + 40px);display:grid;grid-template-columns:minmax(0,1fr);gap:40px 48px}
  @media (min-width:980px){.foot .wrap{grid-template-columns:minmax(180px,2.2fr) minmax(0,6fr) minmax(0,3.8fr)}.foot .colophon{grid-column:1/-1}}
  .foot p{margin:0}
  .foot a{text-decoration:none}
  .foot .name{display:inline-block;font-weight:600;font-size:15px;margin-bottom:14px}
  .foot .tag{font-size:clamp(22px,2vw,28px);line-height:1.1;font-weight:620;letter-spacing:-.025em;font-stretch:108%}
  .foot .dot{color:var(--signal)}
  .foot .sub{margin-top:10px;font-size:14px;color:var(--mist-45)}
  .foot .cols{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 32px}
  @media (min-width:760px){.foot .cols{grid-template-columns:repeat(3,minmax(0,1fr))}}
  .foot .cols .meta{margin-bottom:10px;color:var(--mist-45)}
  .foot .cols a{display:block;padding:4px 0;font-size:15px;color:var(--mist-70);width:max-content;max-width:100%;border-bottom:1px solid transparent;transition:color .2s,border-color .2s}
  .foot .cols a:hover{color:var(--mist);border-color:rgba(26,154,228,.6)}
  .foot .colophon{padding-top:28px;border-top:1px solid var(--mist-15);font-size:13.5px;line-height:1.55;color:var(--mist-45)}
  .foot .colophon p + p{margin-top:4px}
  .foot .legal{margin-top:16px!important}
  .foot .legal a{color:var(--mist-70);border-bottom:1px solid rgba(26,154,228,.5)}
  .foot .legal a:hover{color:var(--mist)}
</style>
