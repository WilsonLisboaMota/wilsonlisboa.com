---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import AiChapter from '../components/AiChapter.astro';
---
<Base>
  <main>
    <Hero />

    <div id="work">
      <AiChapter />

      <section class="next" aria-labelledby="next-title">
        <p class="meta">Still being built</p>
        <h2 id="next-title">The other forces</h2>
        <p>Each force opens its own section. Artificial Intelligence is the first one built.</p>
        <ul class="todo">
          <li id="bi">Business Intelligence <span class="mono">Not built</span></li>
          <li id="leadership">Leadership <span class="mono">Not built</span></li>
          <li id="entrepreneurship">Entrepreneurship <span class="mono">Not built</span></li>
        </ul>
      </section>
    </div>
  </main>
</Base>
