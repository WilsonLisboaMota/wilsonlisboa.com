---
// The end of the page: three ways to reach Wilson, as three things to press, and the last line.
import { person } from '../data/site';
import Icon from './Icon.astro';
---
<section class="sx ct" id="contact" data-sec aria-labelledby="ct-t">
  <div class="w">
    <h2 id="ct-t">Say hello.</h2>
    <div class="ct-g">
      <a class="ct-i" href={`mailto:${person.email}`}><Icon name="mail" /><span>{person.email}</span></a>
      <a class="ct-i" href={person.linkedin} rel="noopener"><Icon name="in" /><span>LinkedIn</span></a>
      <a class="ct-i" href={person.pdf}><Icon name="doc" /><span>The CV, as a PDF</span></a>
    </div>
  </div>
</section>

<footer class="ft">
  <div class="w">
    <p>© {new Date().getFullYear()} Wilson Mota</p>
    <p><a href="/built-with-ai/">How this site was built</a><a href="#top">Back to the surface ↑</a></p>
  </div>
</footer>
