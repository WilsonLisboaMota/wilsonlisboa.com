---
// The CV, on the home page: the document's key lines, and a charged button that opens the full CV with motion.
import '../styles/chapter.css';

const langs = [
  { n: 'Portuguese', l: 'Native · C2', v: 1 },
  { n: 'English', l: 'C1', v: 0.84 },
  { n: 'French', l: 'A2 · learning', v: 0.34 },
  { n: 'German', l: 'A1', v: 0.17 },
];
---
<section class="ch cv" id="cv" aria-labelledby="cv-t">
  <div class="open">
    <p class="meta kick">Curriculum vitae</p>
    <h2 id="cv-t">The CV, in full. <em>With a pulse.</em></h2>
    <div class="acts">
      <a class="btn charged" href="/cv/">Open the CV<span aria-hidden="true">→</span></a>
      <a class="btn ghost" href="/cv/wilson-lisboa-mota-cv.pdf" download>Download the PDF</a>
    </div>
    <p class="ch-lede">The same two-column CV, page for page, where every skill shows the work behind it.</p>
  </div>

  <div class="sheet">
    <div class="col">
      <p class="meta">Experience</p>
      <ul class="xp">
        <li><b>Manager – Business Intelligence Analyst</b><span>Corient · 2025 – present</span></li>
        <li><b>Senior Business Intelligence Analyst</b><span>Stonehage Fleming · 2021 – 2024</span></li>
        <li><b>Business Intelligence Consultant</b><span>Freelance · 2021</span></li>
        <li><b>Co-Founder</b><span>WeValue – Consulting · 2019 – 2021</span></li>
        <li><b>Business Intelligence Analyst</b><span>Scores &amp; Levels · 2019 – 2021</span></li>
      </ul>
    </div>
    <div class="col">
      <p class="meta">Languages</p>
      <ul class="langs">
        {langs.map(l => <li><span class="n">{l.n}<i>{l.l}</i></span><span class="bar"><span class="fill" style={`--v:${l.v}`}></span></span></li>)}
      </ul>
      <p class="meta" style="margin-top:28px">Education</p>
      <ul class="xp">
        <li><b>MSc in Management &amp; Business</b><span>Atlantico Business School · 2019</span></li>
        <li><b>MBA in Business and Management</b><span>Atlantico Business School · 2018</span></li>
        <li><b>Degree in Economics</b><span>ISEG, Lisbon · 2016</span></li>
      </ul>
    </div>
  </div>
  <div class="close"></div>
</section>

<style>
  .cv .acts{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
  @media (min-width:980px){.cv .open .acts{align-self:center;justify-self:end}}
  .cv .btn span{margin-left:2px}
  /* The charged button: the wall's energy runs round its edge, slowly, and brightens on hover. Still under reduced motion. */
  .charged{position:relative;isolation:isolate}
  .charged::before{content:"";position:absolute;inset:-2px;z-index:-1;border-radius:999px;background:conic-gradient(from var(--a,0deg),transparent 0 62%,rgba(26,154,228,.95) 80%,transparent 100%);opacity:.9;transition:opacity .3s}
  .charged::after{content:"";position:absolute;inset:0;z-index:-1;border-radius:999px;background:var(--t1)}
  .charged:hover::before{opacity:1;filter:drop-shadow(0 0 8px rgba(26,154,228,.8))}
  @property --a{syntax:'<angle>';inherits:false;initial-value:0deg}
  @media (prefers-reduced-motion:no-preference){.charged::before{animation:charge 3.2s linear infinite}}
  @keyframes charge{to{--a:360deg}}

  .sheet{display:grid;grid-template-columns:minmax(0,1fr);gap:36px 48px;margin-top:clamp(48px,8vh,88px);padding-top:30px;border-top:1px solid var(--line)}
  @media (min-width:760px){.sheet{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media (min-width:980px){.sheet{margin-left:calc((100% - 96px) * 2.2 / 12 + 48px)}}
  .sheet > .col > .meta{margin-bottom:12px}
  .xp li{display:flex;flex-direction:column;gap:2px;padding:10px 0;border-top:1px solid var(--line2);font-size:16px}
  .xp b{font-weight:600}
  .xp span{color:var(--t3);font-size:14.5px}
  .langs li{display:grid;grid-template-columns:minmax(0,1fr) 120px;align-items:center;gap:14px;padding:8px 0;font-size:16px}
  .langs .n i{font-style:normal;color:var(--t3);font-size:14px;margin-left:10px}
  .langs .bar{position:relative;height:6px;border-radius:3px;background:var(--line2)}
  .langs .fill{position:absolute;inset:0;width:calc(var(--v) * 100%);border-radius:3px;background:var(--cyan)}
</style>
