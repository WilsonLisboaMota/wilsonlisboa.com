.pill-c{--x:21.35;--w:195.15;--h:25.2;top:calc((var(--b) - 17.5) * var(--pt));background:rgba(255,255,255,.25);border-radius:calc(12.6 * var(--pt))}
.ico{position:absolute;left:calc(27.2 * var(--pt));top:calc((var(--b) - 10.6) * var(--pt));width:calc(11.5 * var(--pt));height:calc(11.5 * var(--pt))}
