---
// The small moving drawing on each card or tile: one per piece of work, each showing what that piece does.
// All of them move with CSS only, and only while their card is on screen (see .live in after.css). Pointed at
// (or, on a phone, in the middle of the screen) each one does its own thing faster: see "play" in after.css.
// They are illustrations. The terminal's lines are the real audit of 17 October 2026.
interface Props { kind: 'radar' | 'orbit' | 'stack' | 'seal' | 'house' | 'flow' | 'trade' | 'term' }
const { kind } = Astro.props;

const f = (v: number) => v.toFixed(1);
// Radar: where each blip sits, by angle (clockwise from the right) and distance; it lights as the sweep passes it.
const blips = [[40, 60], [115, 38], [200, 70], [250, 30], [320, 50]].map(([a, r]) => ({ x: 160 + r * Math.cos(a * Math.PI / 180), y: 92 + r * Math.sin(a * Math.PI / 180), d: a / 360 * 4 }));
const six = [0, 1, 2, 3, 4, 5].map(k => ({ x: 160 + 62 * Math.cos(k * Math.PI / 3), y: 90 + 62 * Math.sin(k * Math.PI / 3) }));
// Trading on paper: a price line, and where a bot would buy (below it) and sell (above it).
const price = [[20, 122], [48, 106], [72, 114], [100, 86], [126, 98], [152, 68], [178, 82], [206, 54], [232, 72], [262, 46], [300, 60]];
const priceD = price.map(([x, y], i) => `${i ? 'L' : 'M'}${x} ${y}`).join('');
const trades = [{ x: 72, y: 114, buy: true }, { x: 152, y: 68, buy: false }, { x: 178, y: 82, buy: true }, { x: 262, y: 46, buy: false }];
// Where the money goes: one stream in, four out, each as wide as its share.
const outs = [{ y: 34, w: 15 }, { y: 78, w: 10 }, { y: 114, w: 6 }, { y: 144, w: 3.5 }];
---
{kind === 'radar' && (
  <svg class="vz vz-radar" viewBox="0 0 320 180" aria-hidden="true">
    <circle class="r" cx="160" cy="92" r="28" /><circle class="r" cx="160" cy="92" r="54" /><circle class="r" cx="160" cy="92" r="80" />
    <path class="r" d="M80 92h160M160 12v160" />
    <g class="fast"><g class="sweep"><path class="w" d="M160 92L240 92A80 80 0 0 0 200 22.7Z" /><path class="e" d="M160 92L240 92" /></g></g>
    {blips.map((b, k) => <circle class="blip" cx={f(b.x)} cy={f(b.y)} r="3.5" style={`--d:${b.d.toFixed(2)}s;--k:${k}`} />)}
  </svg>
)}
{kind === 'orbit' && (
  <svg class="vz vz-orbit" viewBox="0 0 320 180" aria-hidden="true">
    <g class="fast"><g class="spin">
      <circle class="r" cx="160" cy="90" r="62" />
      {six.map(p => <path class="r" d={`M160 90L${f(p.x)} ${f(p.y)}`} />)}
      {six.map((p, k) => <circle class="n" cx={f(p.x)} cy={f(p.y)} r="5.5" style={`--k:${k}`} />)}
    </g></g>
    <path class="core" d="M143 77h11l4 4h19v22h-34z" />
  </svg>
)}
{kind === 'stack' && (
  <svg class="vz vz-stack" viewBox="0 0 320 180" aria-hidden="true">
    <g class="s1">
      <rect class="pg" x="70" y="34" width="120" height="112" rx="8" />
      <path class="in" d="M84 54h92M84 70h92M84 86h64M84 102h80M84 118h52" />
      <rect class="tg me" x="84" y="128" width="30" height="12" rx="6" /><text class="tt" x="99" y="137" text-anchor="middle">ME</text>
    </g>
    <g class="s2">
      <rect class="pg" x="130" y="34" width="120" height="112" rx="8" />
      <path class="in" d="M146 118V92M162 118V76M178 118V98M194 118V64M210 118V84M226 118V72M146 52h50" />
      <rect class="tg ai" x="144" y="128" width="30" height="12" rx="6" /><text class="tt" x="159" y="137" text-anchor="middle">AI</text>
    </g>
  </svg>
)}
{kind === 'seal' && (
  <svg class="vz vz-seal" viewBox="0 0 320 180" aria-hidden="true">
    <g class="fast"><circle class="ticks" cx="160" cy="90" r="56" /></g>
    <circle class="echo" cx="160" cy="90" r="42" />
    <circle class="ring" cx="160" cy="90" r="42" />
    <path class="ok" pathLength="1" d="M141 91l13 13 26-28" />
  </svg>
)}
{kind === 'house' && (
  <svg class="vz vz-house" viewBox="0 0 320 180" aria-hidden="true">
    <path class="sky" d="M30 150A130 130 0 0 1 290 150" />
    <g class="sun"><circle cx="160" cy="20" r="9" /></g>
    <path class="roof" d="M90 84 160 42l70 42" />
    <rect class="wall" x="104" y="84" width="112" height="66" rx="3" />
    {[116, 148, 180].map(x => (
      <g><rect class="win" x={x} y="98" width="24" height="30" rx="2" /><rect class="bl" x={x} y="98" width="24" height="30" rx="2" /></g>
    ))}
    <path class="gnd" d="M24 150h272" />
    <g class="pw">{[0, 1, 2].map(k => <rect x={248 + k * 12} y={128 - k * 8} width="7" height={22 + k * 8} rx="2" />)}</g>
  </svg>
)}
{kind === 'flow' && (
  <svg class="vz vz-flow" viewBox="0 0 320 180" aria-hidden="true">
    {outs.map((o, k) => (
      <>
        <path class="st" d={`M24 90C140 90 170 ${o.y} 296 ${o.y}`} stroke-width={o.w} />
        <path class="mv" d={`M24 90C140 90 170 ${o.y} 296 ${o.y}`} stroke-width={Math.max(1.6, o.w * 0.34)} style={`--k:${k}`} />
      </>
    ))}
    <circle class="src" cx="24" cy="90" r="7" />
  </svg>
)}
{kind === 'trade' && (
  <svg class="vz vz-trade" viewBox="0 0 320 180" aria-hidden="true">
    <path class="grid" d="M20 150h280M20 110h280M20 70h280M20 30h280" />
    <path class="pr" d={priceD} />
    <path class="run" pathLength="1000" d={priceD} />
    {trades.map((m, k) => <path class:list={['mk', m.buy ? 'buy' : 'sell']} d={m.buy ? `M${m.x - 7} ${m.y + 24}h14l-7-11z` : `M${m.x - 7} ${m.y - 24}h14l-7 11z`} style={`--k:${k}`} />)}
    <text class="t" x="300" y="170" text-anchor="end">paper money</text>
  </svg>
)}
{kind === 'term' && (
  <span class="vz vz-term" aria-hidden="true">
    <i style="--d:0s">› audit my Power BI model</i>
    <b style="--d:1.2s">← 98 measures run, in one pass</b>
    <b style="--d:2.4s">← <u>7 broken</u> · 2 root causes</b>
    <b style="--d:3.6s">← read-only: nothing was changed</b>
  </span>
)}
