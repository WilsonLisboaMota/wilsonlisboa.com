---
// Leadership: the formation from the hero, then other people's words. The role itself is one button away.
import { quotes, today } from '../data/site';

// The formation: one in front, six behind in two wings, flying right. No lines join the points; each has a short trail
// that fades behind it and is drawn from its tail to its point, so the seven arrive together.
const f = (v: number) => v.toFixed(1);
let seed = 11;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const pts: [number, number, number][] = [[292, 100, 0]];
for (let k = 1; k <= 3; k++) { pts.push([292 - 60 * k, 100 - 27 * k, k]); pts.push([292 - 60 * k, 100 + 27 * k, k]); }
let defs = '', body = '';
pts.forEach(([x, y, k], i) => {
  const len = i ? 70 + rnd() * 35 : 150, ph = rnd() * 6;
  let path = '';
  for (let s = len; s >= 0; s -= 6) path += `${path ? 'L' : 'M'}${f(x - s)} ${f(y + 4.5 * Math.sin(ph + s / 22) * (s / len))}`;
  defs += `<linearGradient id="tr${i}" gradientUnits="userSpaceOnUse" x1="${f(x - len)}" y1="${y}" x2="${x}" y2="${y}"><stop offset="0" style="stop-color:var(--acc);stop-opacity:0"/><stop offset="1" style="stop-color:var(--acc);stop-opacity:${i ? 0.8 : 1}"/></linearGradient>`;
  body += `<path d="${path}" style="stroke:url(#tr${i});stroke-opacity:1;stroke-width:1.3;--dl:${f(k * 0.12 + rnd() * 0.08)}s"/>`;
});
body += pts.map(([x, y], i) => `<circle cx="${x}" cy="${y}" r="${i ? 3 : 4.6}"/>`).join('');
const sig = `<defs>${defs}</defs>${body}`;

const featured = quotes.find(q => q.featured)!;
const rest = quotes.filter(q => !q.featured);
const chev = '<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4.2 6 8l4-3.8"/></svg>';
---
<section class="sx paper" id="leadership" data-sec aria-labelledby="ld-t">
  <div class="w">
    <div class="hd">
      <p class="meta kick">Leadership</p>
      <h2 id="ld-t">Analyst by trade. <em>Manager by choice.</em></h2>
      <svg class="sig" viewBox="0 0 320 200" aria-hidden="true" set:html={sig}></svg>
      <p class="ld">From BI analyst in 2019 to leading a team of six BI developers today.</p>
    </div>

    <div class="says">
      <p class="meta" style="margin-bottom:18px">What colleagues say</p>
      <figure class="qf">
        <blockquote><p>“{featured.text}”</p></blockquote>
        <figcaption class="who"><b>{featured.name}</b>{featured.role}</figcaption>
      </figure>
      <div class="qm">
        {rest.map(q => (
          <figure>
            <blockquote><p>“{q.text}”</p></blockquote>
            <figcaption class="who"><b>{q.name}</b>{q.role}{q.href && <> · <a class="lk" href={q.href} rel="noopener">{q.a}</a></>}</figcaption>
          </figure>
        ))}
      </div>
    </div>

    <div class="ld-b">
      <button class="go-b" type="button" aria-expanded="false" aria-controls="bh-lead"><span class="x">Go behind: the role today</span><span class="y">Back to the surface</span><Fragment set:html={chev} /></button>
      <div class="bh" id="bh-lead">
        <div class="bh-in">
          <p class="bh-sub">The role today · Corient</p>
          <ul class="resp">
            {today.map(t => <li><h4>{t.t}</h4><p>{t.d}</p></li>)}
          </ul>
          <p class="bh-sub">Before the team</p>
          <div class="wv">
            <p class="who"><b>WeValue</b>Co-founder · 2019 – 2021</p>
            <p>I co-founded a consulting firm, where I ran management and client advisory and was responsible for public contracts. 9 of the 10 projects I submitted were approved.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
