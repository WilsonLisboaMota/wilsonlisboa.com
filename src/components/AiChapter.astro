---
// Artificial Intelligence: what the AI does in Wilson's life, one tile per project, each with its own moving drawing.
// What is behind a tile opens in a sheet: what he decided, what the AI did, and what is not there yet.
// (The relay between "ME" and "AI" was removed on 12 November 2026: it said nothing to the visitor. The same split
// is in every sheet, with the facts of that project.)
import { projects } from '../data/site';
import Tile from './Tile.astro';
import Sheet from './Sheet.astro';
import Title from './Title.astro';

// The AI drawing from the hero: about 44 curves that start scattered and converge on one point.
const fx = 268, fy = 112;
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
let sig = '', pulses = '', np = 0;
for (let i = 0; i < 44; i++) {
  const sx = rnd() * 150, sy = 10 + rnd() * 180;
  const c1x = sx + 60 + rnd() * 60, c1y = sy + (rnd() - .5) * 60, c2x = fx - 70 - rnd() * 40, c2y = fy + (sy - fy) * (0.25 + rnd() * 0.3);
  const d = `M${sx.toFixed(1)} ${sy.toFixed(1)}C${c1x.toFixed(1)} ${c1y.toFixed(1)} ${c2x.toFixed(1)} ${c2y.toFixed(1)} ${fx} ${fy}`;
  sig += `<path d="${d}" style="--dl:${(rnd() * 0.5).toFixed(2)}s"/>`;
  // Once drawn, a light runs down a few of the lines into the point, one after another, and the point answers.
  if (i % 7 === 3) pulses += `<path class="pl" pathLength="100" d="${d}" style="--pd:${(np++ * 0.55).toFixed(2)}s"/>`;
}
sig += pulses + `<circle class="ring" cx="${fx}" cy="${fy}" r="3.5"/><circle cx="${fx}" cy="${fy}" r="3.5"/>`;

---
<section class="sx" id="ai" data-sec data-glow aria-labelledby="ai-t">
  <div class="glow" aria-hidden="true"><svg><rect width="100%" height="100%" fill="url(#wl-dark)" /></svg></div>
  <div class="w">
    <div class="hd">
      <div class="ent"><svg class="sig" viewBox="0 0 320 200" aria-hidden="true" set:html={sig}></svg><p class="ent-n">Artificial Intelligence</p></div>
      <Title id="ai-t" a="AI brings speed." b="We bring judgement." />
    </div>

    <h3 class="sub">My AI projects</h3>
    <div class="bento" data-seq>
      {projects.map(p => <Tile w={p} />)}
    </div>
  </div>
  {projects.map(p => <Sheet w={p} />)}
</section>
