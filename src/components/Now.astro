---
// Now: the first thing on the far side of the wall is a person. One line, three facts, a small photo and the CV.
import '../styles/chapter.css';
---
<section class="ch now" id="now" aria-labelledby="now-t">
  <div class="open">
    <p class="meta kick">Now</p>
    <img class="photo" src="/cv/photo.jpg" width="96" height="96" alt="Wilson Lisboa Mota" loading="lazy" decoding="async">
    <h2 id="now-t">BI Manager at Corient. <em>Based in Fribourg, Switzerland.</em></h2>
    <p class="ch-lede">I lead the BI team, and build with AI on my own time.</p>
  </div>
  <div class="row4">
    <ul class="rules facts">
      <li class="rule"><h3>7 years</h3><p>In Business Intelligence, in regulated environments, from analyst to manager.</p></li>
      <li class="rule"><h3>A team of six</h3><p>BI developers delivering analytical solutions to the whole group.</p></li>
      <li class="rule"><h3>Three AI projects</h3><p>A trading bot on paper, a personal CFO and a property deal radar.</p></li>
      <li class="rule"><h3>The CV</h3><p>As a document, with motion, and as a PDF.</p><a href="/cv/">Open the CV</a></li>
    </ul>
  </div>
</section>

<style>
  /* The photo sits in the label column, under the kicker, like a byline; the title takes the rest of the row. */
  .now .photo{display:block;width:96px;height:96px;margin-bottom:8px;border-radius:50%;object-fit:cover;object-position:50% 28%;box-shadow:0 0 0 1px var(--line),0 18px 40px rgba(2,28,42,.25)}
  /* Facts carry no links but the last one, so they align like the rules of the AI chapter. */
  .now .facts h3{font-size:clamp(24px,2vw,30px)}
  @media (min-width:980px){.now .open{grid-template-rows:auto auto auto}.now .open .kick{grid-row:1}.now .open .photo{grid-row:2;grid-column:1;margin:0}.now .open h2{grid-row:1/span 2;grid-column:2/-1}.now .open .ch-lede{grid-row:3}}
  @media (max-width:979px){.now .open .photo{order:-1}}
</style>
