.bl{--s:9;color:#404040}
.bl::before{content:"•";position:absolute;left:calc(-11.1 * var(--pt))}
.cti{--s:11.04;font-weight:700;color:#000}
.lnk{color:#0563C1;font-size:calc(9 * var(--pt))}
.mag{display:inline-block;width:calc(8 * var(--pt));height:calc(8 * var(--pt));margin-left:calc(3 * var(--pt));vertical-align:calc(-.4 * var(--pt));padding:0;border:0;background:none;color:#8C8C8C}
.mag svg{display:block;width:100%;height:100%}
button.mag{cursor:help}
.live-w{display:inline-block}

/* Charged lines: a surge of energy, then a steady glow while the skill is held. The rest steps back. */
.paper [data-line]{transition:opacity .35s var(--ease),color .35s var(--ease)}
html.e-dim .paper [data-line]:not(.e-held){opacity:.34}
.paper .e-held{color:#1F3F73;text-shadow:0 0 .55em rgba(47,84,150,.3)}
.paper .e-held .w{color:#0B2E66;text-shadow:0 0 .55em rgba(224,149,47,.8),0 0 .14em rgba(224,149,47,.55)}
