---
// The wall, seen from behind. Goes first inside a band: a sticky layer the height of the screen that the content scrolls
// over, holding three tiles of membrane lines. The far layers move less than the page (CSS scroll-driven animation,
// compositor only); where that is not supported the lines simply stay put, which already reads as a wall far behind.
// No JavaScript, and the band's own background is in CSS, so nothing can ever get out of step with the scroll.
interface Props { k: string }
const { k } = Astro.props;

// Seamless tiles: integer wave cycles across the tile width, rows spread over the tile height.
function rng(seed: number) { let s = seed; return () => ((s = (s * 16807) % 2147483647) / 2147483647); }
const W = 1400, H = 700;
function tile(seed: number, rows: number, amp: number, c1: number, c2: number) {
  const R = rng(seed);
  let d = '';
  for (let r = 0; r < rows; r++) {
    const y0 = ((r + 0.5) / rows) * H, p1 = R() * Math.PI * 2, p2 = R() * Math.PI * 2, a2 = amp * (0.25 + R() * 0.3);
    for (let x = 0; x <= W; x += 20) {
      const y = y0 + amp * Math.sin((2 * Math.PI * c1 * x) / W + p1) + a2 * Math.sin((2 * Math.PI * c2 * x) / W + p2);
      d += (x ? 'L' : 'M') + x + ' ' + y.toFixed(1);
    }
  }
  return d;
}
const layers = [
  { n: 'far', d: tile(3, 7, 14, 2, 5) },
  { n: 'mid', d: tile(5, 5, 22, 1, 3) },
  { n: 'near', d: tile(7, 4, 32, 1, 4) },
];
---
<div class="veil" aria-hidden="true">
  {layers.map(l => (
    <div class={`layer ${l.n}`}>
      <svg width="100%" height="100%">
        <defs><pattern id={`w-${k}-${l.n}`} width={W} height={H} patternUnits="userSpaceOnUse"><path d={l.d} fill="none" stroke="currentColor" stroke-width="1" /></pattern></defs>
        <rect width="100%" height="100%" fill={`url(#w-${k}-${l.n})`} />
      </svg>
    </div>
  ))}
</div>
